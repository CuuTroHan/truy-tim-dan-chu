    private int _countdownRemainingSeconds = 3;
    private System.Threading.Timer? _countdownTimer;

    private void OnCountdownStarted(CountdownStartedEvent e)
    {
        InvokeAsync(() =>
        {
            if (Room is not null)
            {
                Room = Room with { Status = RoomStatus.Countdown, MatchId = e.MatchId, MatchStartTimeUtc = e.MatchStartTimeUtc };
            }
            _countdownRemainingSeconds = e.CountdownSeconds;
            _countdownTimer?.Dispose();
            _countdownTimer = new System.Threading.Timer(_ =>
            {
                if (Room?.Status == RoomStatus.Countdown && Room.MatchStartTimeUtc.HasValue)
                {
                    var rem = (int)Math.Ceiling((Room.MatchStartTimeUtc.Value - DateTimeOffset.UtcNow).TotalSeconds);
                    _countdownRemainingSeconds = Math.Max(0, rem);
                    InvokeAsync(StateHasChanged);
                }
            }, null, 300, 300);
            StateHasChanged();
        });
    }

    private void OnCountdownCanceled(CountdownCanceledEvent e)
    {
        InvokeAsync(() =>
        {
            _countdownTimer?.Dispose();
            _countdownTimer = null;
            if (Room is not null)
            {
                Room = Room with { Status = RoomStatus.Lobby, MatchId = null, MatchStartTimeUtc = null };
            }
            StateHasChanged();
        });
    }

    private void OnMatchStarted(MatchStartedEvent e)
    {
        InvokeAsync(() =>
