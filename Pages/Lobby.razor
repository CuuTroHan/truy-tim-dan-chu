    private async Task SaveEditTeam(string teamId)
    {
        if (Connection is null || string.IsNullOrEmpty(AdminToken) || Room is null) return;
        var trimmedName = _editName?.Trim();
        if (string.IsNullOrEmpty(trimmedName) || trimmedName.Length < 2)
        {
            _teamActionError = "Tên đội phải có ít nhất 2 ký tự.";
            return;
        }

        _teamActionError = null;
        _isActionSubmitting = true;
        try
        {
            var req = new AdminUpdateTeamRequest(Room.RoomId, AdminToken, teamId, trimmedName, _editColor, _editCapacity);
            var res = await Connection.AdminUpdateTeamAsync(req);
            if (res.Success && res.Team is not null)
            {
                _editingTeamId = null;
                UpdateTeamInList(res.Team);
            }
            else
            {
                _teamActionError = MapTeamError(res.ErrorCode);
            }
        }
        finally
        {
            _isActionSubmitting = false;
        }
    }

    private async Task MoveTeam(int index, int direction)
    {
        if (Connection is null || string.IsNullOrEmpty(AdminToken) || Room is null) return;
        var targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= _teams.Count) return;

        var list = _teams.Select(t => t.TeamId).ToList();
        var temp = list[index];
        list[index] = list[targetIndex];
        list[targetIndex] = temp;

        _teamActionError = null;
        _isActionSubmitting = true;
        try
        {
            var req = new AdminReorderTeamsRequest(Room.RoomId, AdminToken, list);
            var res = await Connection.AdminReorderTeamsAsync(req);
            if (res.Success && res.Teams is not null)
            {
                _teams.Clear();
                _teams.AddRange(res.Teams);
                StateHasChanged();
            }
            else
            {
                _teamActionError = MapTeamError(res.ErrorCode);
            }
        }
        finally
        {
            _isActionSubmitting = false;
        }
    }

