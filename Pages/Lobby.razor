    private void OnPlayerTeamChanged(PlayerTeamChangedEvent ev)
    {
        InvokeAsync(() =>
        {
            var pIdx = _players.FindIndex(p => p.PlayerId == ev.PlayerId);
            if (pIdx >= 0)
            {
                _players[pIdx] = _players[pIdx] with { TeamId = ev.NewTeamId };
            }

            if (!string.IsNullOrEmpty(ev.OldTeamId))
            {
                var oldIdx = _teams.FindIndex(t => t.TeamId == ev.OldTeamId);
                if (oldIdx >= 0)
                {
                    _teams[oldIdx] = _teams[oldIdx] with { MemberCount = Math.Max(0, _teams[oldIdx].MemberCount - 1) };
                }
            }
            if (!string.IsNullOrEmpty(ev.NewTeamId))
            {
                var newIdx = _teams.FindIndex(t => t.TeamId == ev.NewTeamId);
                if (newIdx >= 0)
                {
                    _teams[newIdx] = _teams[newIdx] with { MemberCount = _teams[newIdx].MemberCount + 1 };
                }
            }

            StateHasChanged();
        });
    }

