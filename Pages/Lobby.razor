@using TruyTimDanChu.Services
@using TruyTimDanChu.Shared
@implements IDisposable

<section class="lobby-card" aria-labelledby="lobby-title">
    <header class="lobby-header">
        <div class="lobby-code-badge">
            <span>MÃ PHÒNG</span>
            <strong data-testid="lobby-room-code">@(Room?.RoomCode ?? "DC-XXXX")</strong>
        </div>
        <div class="lobby-meta">
            <h2 id="lobby-title">@(Room?.RoomName ?? "Phòng thi đấu")</h2>
            <div class="lobby-badges">
                <span class="status-pill">● @(Room?.Status.ToString() ?? "Lobby")</span>
                @if (Room?.IsJoinLocked ?? false)
                {
                    <span class="lock-pill" title="Phòng đang khóa người mới tham gia">🔒 Khóa vào</span>
                }
                @if (Room?.IsRosterLocked ?? false)
                {
                    <span class="lock-pill" title="Đội hình hiện đang khóa tự chọn">🔒 Khóa đội</span>
                }
                @if (IsAdmin)
                {
                    <span class="admin-badge">✦ QUẢN TRỊ VIÊN</span>
                }
                else
                {
                    <span class="player-badge">NGƯỜI CHƠI</span>
                }
            </div>
        </div>
    </header>

    <div class="lobby-content">
        @{
            // Admin quyết định thời điểm bắt đầu; người chơi không cần bấm "sẵn sàng".
            var validation = ReadinessValidator.Validate(Room, _players, _teams.Select(t => t with { MemberCount = GetTeamMemberCount(t.TeamId) }).ToList(), requirePlayersReady: false);
            var localPlayer = GetMyPlayer();
            var canSelectAvatar = localPlayer is not null;
        }

        <div class="lobby-layout">
            <!-- CỘT CHÍNH (TRÁI): CÁC ĐỘI & CẤU HÌNH ADMIN & CHỌN NGOẠI HÌNH -->
            <div class="lobby-main-col">
                <!-- Danh sách Đội thi đấu -->
                <div class="teams-section">
            <div class="roster-header">
                <h3>Các đội thi đấu (@_teams.Count)</h3>
                <div class="roster-header-right">
                    <span class="roster-hint">Tổng sức chứa: @_teams.Sum(t => t.Capacity) người</span>
                    @if (IsAdmin)
                    {
                        <label class="admin-policy-toggle" title="Khóa/mở khóa không cho người mới vào phòng">
                            <input type="checkbox"
                                   checked="@(Room?.IsJoinLocked ?? false)"
                                   disabled="@_isActionSubmitting"
                                   @onchange="ToggleJoinLock" />
                            <span>Khóa vào</span>
                        </label>
                        <label class="admin-policy-toggle" title="Khóa/mở khóa không cho người chơi tự đổi đội">
                            <input type="checkbox"
                                   checked="@(Room?.IsRosterLocked ?? false)"
                                   disabled="@_isActionSubmitting"
                                   @onchange="ToggleRosterLock" />
                            <span>Khóa đội</span>
                        </label>
                        <label class="admin-policy-toggle" title="Bật/tắt cho phép người chơi tự chọn đội">
                            <input type="checkbox"
                                   checked="@(Room?.AllowSelfTeamSelection ?? true)"
                                   disabled="@_isActionSubmitting"
                                   @onchange="ToggleSelfTeamSelection" />
                            <span>Tự chọn đội</span>
                        </label>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_teamActionError))
            {
                <div class="team-action-error" role="alert">
                    @_teamActionError
                </div>
            }

            <div class="team-roster">
                @if (_teams.Count == 0)
                {
                    <div class="empty-roster">Chưa có đội thi đấu nào. @(IsAdmin ? "Hãy thêm ít nhất một đội bên dưới." : "Đang chờ Admin thiết lập đội.")</div>
                }
                else
                {
                    <div class="team-grid">
                        @for (int i = 0; i < _teams.Count; i++)
                        {
                            var idx = i;
                            var team = _teams[i];
                            var isEditing = _editingTeamId == team.TeamId;

                            <div class="team-card" style="border-left-color: @team.Color" data-team-id="@team.TeamId" data-testid="team-card-@team.TeamId">
                                @if (isEditing)
                                {
                                    <div class="team-card-edit-form">
                                        <div class="edit-row">
                                            <input type="text"
                                                   class="edit-name-input"
                                                   @bind="_editName"
                                                   @bind:event="oninput"
                                                   placeholder="Tên đội"
                                                   maxlength="30" />
                                            <input type="number"
                                                   class="edit-cap-input"
                                                   @bind="_editCapacity"
                                                   @bind:event="oninput"
                                                   min="1"
                                                   max="8" />
                                        </div>
                                        <div class="color-palette mini-palette">
                                            @foreach (var c in PresetColors)
                                            {
                                                <button type="button"
                                                        class="color-chip mini @(_editColor == c ? "selected" : "")"
                                                        style="background-color: @c"
                                                        @onclick="() => _editColor = c"
                                                        aria-label="@c">
                                                    @if (_editColor == c)
                                                    {
                                                        <span class="color-check">✓</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                        <div class="edit-buttons">
                                            <button class="primary-button small-btn save-team-btn"
                                                    disabled="@(_isActionSubmitting || string.IsNullOrWhiteSpace(_editName))"
                                                    @onclick="() => SaveEditTeam(team.TeamId)">
                                                LƯU
                                            </button>
                                            <button class="secondary-button small-btn cancel-team-btn"
                                                    disabled="@_isActionSubmitting"
                                                    @onclick="CancelEditTeam">
                                                HỦY
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="team-card-header">
                                        <span class="team-color-indicator" style="background-color: @team.Color"></span>
                                        <strong class="team-name">@team.Name</strong>
                                        <span class="team-capacity-badge">
                                            @GetTeamMemberCount(team.TeamId) / @team.Capacity người
                                        </span>
                                        @if (IsAdmin)
                                        {
                                            <div class="team-admin-actions">
                                                <button class="icon-btn move-up-btn"
                                                        title="Di chuyển lên"
                                                        disabled="@(idx == 0 || _isActionSubmitting)"
                                                        @onclick="() => MoveTeam(idx, -1)">▲</button>
                                                <button class="icon-btn move-down-btn"
                                                        title="Di chuyển xuống"
                                                        disabled="@(idx == _teams.Count - 1 || _isActionSubmitting)"
                                                        @onclick="() => MoveTeam(idx, 1)">▼</button>
                                                <button class="icon-btn edit-btn"
                                                        title="Chỉnh sửa đội"
                                                        disabled="@_isActionSubmitting"
                                                        @onclick="() => StartEditTeam(team)">✏️</button>
                                                <button class="icon-btn delete-btn"
                                                        title="Xóa đội"
                                                        disabled="@(GetTeamMemberCount(team.TeamId) > 0 || _isActionSubmitting)"
                                                        @onclick="() => RemoveTeam(team.TeamId)">🗑️</button>
                                            </div>
                                        }
                                    </div>

                                    var members = _players.Where(p => p.TeamId == team.TeamId).ToList();
                                    var myPlayer = localPlayer;
                                    var isMyTeam = myPlayer?.TeamId == team.TeamId;
                                    var isFull = GetTeamMemberCount(team.TeamId) >= team.Capacity;
                                    var canSelfSelect = (Room?.AllowSelfTeamSelection ?? true) && (myPlayer is not null);

                                    <div class="team-members">
                                        @if (members.Count == 0)
                                        {
                                            <span class="no-members-hint">Chưa có thành viên</span>
                                        }
                                        else
                                        {
                                            <div class="team-members-chips">
                                                @foreach (var m in members)
                                                {
                                                    var mAvatar = AvatarCatalog.Get(m.AvatarId) ?? AvatarCatalog.Get(AvatarCatalog.DefaultAvatarId);
                                                    var disc = AvatarCatalog.GetDiscriminator(m.PlayerId, _players);
                                                    <span class="member-chip @(m.PlayerId == myPlayer?.PlayerId ? "is-me" : "")">
                                                        <span class="mini-sprite" style="background-image: url('@(mAvatar?.AssetPath)');"></span>
                                                        @m.DisplayName@(string.IsNullOrEmpty(disc) ? "" : " " + disc) @(m.PlayerId == myPlayer?.PlayerId ? "(Bạn)" : "")
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (Room?.IsRosterLocked ?? false)
                                    {
                                        <div class="team-card-actions">
                                            <span class="roster-locked-hint" title="Quản trị viên đã khóa đội hình">🔒 Đội hình đã khóa</span>
                                        </div>
                                    }
                                    else if (canSelfSelect)
                                    {
                                        <div class="team-card-actions">
                                            @if (isMyTeam)
                                            {
                                                <button class="secondary-button small-btn leave-team-btn"
                                                        disabled="@_isActionSubmitting"
                                                        @onclick="LeaveTeam">
                                                    RỜI ĐỘI
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="primary-button small-btn join-team-btn" data-testid="join-team-@team.TeamId"
                                                        disabled="@(_isActionSubmitting || isFull)"
                                                        @onclick="() => JoinTeam(team.TeamId)">
                                                    @(isFull ? "ĐÃ ĐẦY" : "VÀO ĐỘI")
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (IsAdmin && !string.IsNullOrEmpty(AdminToken) && Room is not null)
            {
                <TeamEditor Connection="Connection"
                            RoomId="@Room.RoomId"
                            AdminToken="@AdminToken"
                            OnTeamAdded="HandleTeamAdded" />
                <div class="admin-settings-card">
                    <div class="admin-settings-header">
                        <h4>✦ TÙY CHỌN TRẬN ĐẤU</h4>
                        <span class="admin-settings-sub">Thiết lập luật thi đấu &amp; vai trò Admin</span>
                    </div>

                    <div class="admin-settings-grid">
                        <div class="admin-setting-item">
                            <div class="setting-action">
                                <button class="secondary-button setting-toggle-btn @(Room.AdminCanPlay ? "is-active" : "")"
                                        disabled="@_isActionSubmitting"
                                        @onclick="ToggleAdminCanPlay">
                                    @(Room.AdminCanPlay ? "TẮT ADMIN CHƠI" : "BẬT ADMIN CHƠI")
                                </button>
                            </div>
                            <div class="setting-desc">
                                @(Room.AdminCanPlay ? "Admin được phép vào một đội và tham gia giải đố như người chơi." : "Admin chỉ điều hành trận đấu, không tham gia vào đội nào.")
                            </div>
                        </div>

                        <div class="admin-setting-item">
                            <div class="setting-action">
                                <button class="secondary-button setting-toggle-btn @(Room.EndOnFirstFinish ? "is-active" : "")"
                                        data-testid="toggle-end-on-first-finish"
                                        disabled="@_isActionSubmitting || Room.Status != RoomStatus.Lobby"
                                        @onclick="ToggleEndOnFirstFinish">
                                    @(Room.EndOnFirstFinish ? "TẮT KẾT THÚC KHI ĐỘI ĐẦU TIÊN XONG" : "BẬT KẾT THÚC KHI ĐỘI ĐẦU TIÊN XONG")
                                </button>
                            </div>
                            <div class="setting-desc">
                                @(Room.EndOnFirstFinish ? "Đội đầu tiên hoàn thành sẽ kết thúc trận cho tất cả." : "Các đội tiếp tục đến khi tất cả hoàn thành hoặc hết giờ.")
                            </div>
                        </div>
                    </div>

                    @if (Room.AdminCanPlay && !_players.Any(p => p.IsAdmin))
                    {
                        <div class="admin-join-box">
                            <div class="admin-join-header">
                                <strong>👤 Admin tham gia vào đội thi đấu:</strong>
                                <small>Chọn đội và đặt tên nhân vật đại diện trong trận</small>
                            </div>
                            <div class="admin-join-row">
                                <div class="admin-join-field">
                                    <label>ĐỘI THI ĐẤU</label>
                                    <select class="admin-join-select" @bind="_adminPlayTeamId">
                                        @if (_teams.Count == 0)
                                        {
                                            <option value="">(Chưa có đội nào)</option>
                                        }
                                        else
                                        {
                                            @foreach (var team in _teams)
                                            {
                                                <option value="@team.TeamId">@team.Name (@GetTeamMemberCount(team.TeamId)/@team.Capacity)</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="admin-join-field flex-grow">
                                    <label>TÊN HIỂN THỊ TRONG GAME</label>
                                    <input class="admin-join-input" @bind="_adminPlayName" placeholder="Tên admin trong game" maxlength="24" />
                                </div>
                                <div class="admin-join-field action-field">
                                    <button class="primary-button admin-join-btn"
                                            disabled="@(_isActionSubmitting || string.IsNullOrWhiteSpace(_adminPlayTeamId))"
                                            @onclick="JoinAdminAsPlayer">
                                        VÀO CHƠI
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

                @if (canSelectAvatar)
                {
                    <div class="avatar-section">
                        <AvatarPicker SelectedAvatarId="@(localPlayer?.AvatarId ?? AvatarCatalog.DefaultAvatarId)"
                                      CurrentPlayerId="@(localPlayer?.PlayerId ?? CurrentPlayerId)"
                                      RoomPlayers="@_players"
                                      Disabled="@_isActionSubmitting"
                                      ErrorMessage="@_avatarActionError"
                                      OnAvatarSelected="SelectAvatar" />
                    </div>
                }
            </div>

            <!-- CỘT PHỤ (PHẢI): BẮT ĐẦU TRẬN, ĐIỀU KIỆN & DANH SÁCH NGƯỜI CHƠI -->
            <div class="lobby-sidebar-col">
                @if (IsAdmin && validation.CanStart && Room?.Status == RoomStatus.Lobby)
                {
                    <div class="admin-start-bar" style="margin-top: 0; margin-bottom: 0;">
                        <button class="primary-button start-match-btn" data-testid="admin-start-match"
                                disabled="@_isActionSubmitting"
                                @onclick="StartMatch">
                            🚀 BẮT ĐẦU TRẬN ĐẤU
                        </button>
                    </div>
                }

                @if (Room?.Status == RoomStatus.Countdown)
                {
                    <div class="countdown-overlay" role="alert" aria-live="assertive">
                        <div class="countdown-card">
                            <div class="countdown-icon">⏳</div>
                            <h3>TRẬN ĐẤU SẮP BẮT ĐẦU!</h3>
                            <div class="countdown-number">@_countdownRemainingSeconds</div>
                            <p>Chuẩn bị bước vào thị trấn Minh Đăng cùng đồng đội...</p>
                            @if (IsAdmin)
                            {
                                <button class="secondary-button cancel-countdown-btn"
                                        disabled="@_isActionSubmitting"
                                        @onclick="CancelCountdown">
                                    ✕ HỦY ĐẾM NGƯỢC
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!validation.CanStart)
                {
                    <div class="readiness-banner blocked" role="status">
                        <div class="banner-icon">⚠️</div>
                        <div class="banner-body">
                            <strong>Chưa đủ đội hình (@validation.BlockingReasons.Count điều kiện)</strong>
                            <ul class="banner-reasons">
                                @foreach (var r in validation.BlockingReasons)
                                {
                                    <li>@r</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                @if (validation.Warnings.Count > 0)
                {
                    <div class="readiness-banner warning" role="status">
                        <div class="banner-icon">ℹ️</div>
                        <div class="banner-body">
                            <strong>Lưu ý đội hình:</strong>
                            <ul class="banner-reasons">
                                @foreach (var w in validation.Warnings)
                                {
                                    <li>@w</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <!-- Danh sách Người chơi -->
                <div class="player-roster">
                    <div class="roster-header">
                        <h3>Danh sách người chơi (@_players.Count)</h3>
                        <span class="roster-hint">Đang chờ phân đội</span>
                    </div>

                    @if (_players.Count == 0)
                    {
                        <div class="empty-roster">Chưa có người chơi nào trong danh sách.</div>
                    }
                    else
                    {
                        <ul class="player-list">
                            @foreach (var p in _players)
                            {
                                var isMe = p.PlayerId == (localPlayer?.PlayerId ?? CurrentPlayerId);
                                var pAvatar = AvatarCatalog.Get(p.AvatarId) ?? AvatarCatalog.Get(AvatarCatalog.DefaultAvatarId);
                                var pDisc = AvatarCatalog.GetDiscriminator(p.PlayerId, _players);
                                <li class="player-item @(isMe ? "is-me" : "")" data-testid="player-row-@p.PlayerId">
                                    <div class="player-avatar-preview-box" title="@(pAvatar?.DisplayName ?? "Avatar")">
                                        <div class="pipoya-sprite dir-down" style="background-image: url('@(pAvatar?.AssetPath)');"></div>
                                    </div>
                                    <div class="player-info">
                                        <div class="player-name-row">
                                            <span class="player-name">
                                                @p.DisplayName
                                                @if (!string.IsNullOrEmpty(pDisc))
                                                {
                                                    <span class="discriminator-badge" title="Ký hiệu phân biệt khi trùng nhân vật">@pDisc</span>
                                                }
                                                @if (isMe)
                                                {
                                                    <small class="me-tag">(Bạn)</small>
                                                }
                                            </span>
                                            @if (!string.IsNullOrEmpty(p.TeamId))
                                            {
                                                var pTeam = _teams.FirstOrDefault(t => t.TeamId == p.TeamId);
                                                if (pTeam is not null)
                                                {
                                                    <span class="player-team-pill" style="border-color: @pTeam.Color; color: @pTeam.Color">
                                                        ● @pTeam.Name
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="player-team-pill unassigned">Chưa vào đội</span>
                                            }
                                        </div>
                                    </div>
                                    @if (IsAdmin)
                                    {
                                        <div class="player-admin-actions">
                                            <select class="admin-team-select"
                                                    data-testid="admin-team-select-@p.PlayerId"
                                                    value="@(p.TeamId ?? "")"
                                                    disabled="@_isActionSubmitting"
                                                    @onchange="(e) => MovePlayer(p.PlayerId, e)">
                                                <option value="">-- Chưa vào đội --</option>
                                                @foreach (var t in _teams)
                                                {
                                                    <option value="@t.TeamId">
                                                        @t.Name (@GetTeamMemberCount(t.TeamId)/@t.Capacity)
                                                    </option>
                                                }
                                            </select>
                                            <button class="icon-btn kick-btn"
                                                    data-testid="kick-player-@p.PlayerId"
                                                    title="Đuổi khỏi phòng"
                                                    disabled="@(_isActionSubmitting || p.PlayerId == (localPlayer?.PlayerId ?? CurrentPlayerId))"
                                                    @onclick="() => KickPlayer(p.PlayerId)">❌</button>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                @if (IsAdmin)
                {
                    <div class="admin-lobby-notice">
                        <p>✦ Bạn là Admin. Bạn có thể thêm, sửa tên/màu/sức chứa, đổi thứ tự và xóa đội rỗng ở trên.</p>
                    </div>
                }
                else
                {
                    <div class="player-lobby-notice">
                        <p>✦ Hãy chọn một đội thi đấu và ngoại hình. Admin sẽ bắt đầu trận khi đội hình đã đủ.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public MultiplayerConnection? Connection { get; set; }
    [Parameter] public RoomSnapshot? Room { get; set; }
    [Parameter] public List<PlayerSnapshot> InitialPlayers { get; set; } = [];
    [Parameter] public List<TeamSnapshot> InitialTeams { get; set; } = [];
    [Parameter] public string? CurrentPlayerId { get; set; }
    [Parameter] public EventCallback<string> OnCurrentPlayerIdChanged { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string? AdminToken { get; set; }

    private PlayerSnapshot? GetMyPlayer() =>
        _players.FirstOrDefault(p => p.PlayerId == CurrentPlayerId)
        ?? (IsAdmin ? _players.FirstOrDefault(p => p.IsAdmin) : null);

    private static readonly string[] PresetColors =
    [
        "#E53935", "#1E88E5", "#43A047", "#FB8C00",
        "#8E24AA", "#00ACC1", "#FDD835", "#6D4C41"
    ];

    private readonly List<PlayerSnapshot> _players = [];
    private readonly List<TeamSnapshot> _teams = [];

    private string? _editingTeamId;
    private string _editName = "";
    private string _editColor = "#E53935";
    private int _editCapacity = 4;
    private string? _teamActionError;
    private string? _avatarActionError;
    private string? _readyResetNotice;
    private bool _isActionSubmitting;
    private string? _adminPlayTeamId;
    private string _adminPlayName = "Quản trị viên";

    private int GetTeamMemberCount(string teamId) => _players.Count(p => p.TeamId == teamId);

    protected override void OnParametersSet()
    {
        if (InitialPlayers.Count > 0 && (_players.Count == 0 || InitialPlayers.Count != _players.Count || !InitialPlayers.SequenceEqual(_players)))
        {
            _players.Clear();
            _players.AddRange(InitialPlayers);
        }
        if (InitialTeams.Count > 0 && (_teams.Count == 0 || InitialTeams.Count != _teams.Count || !InitialTeams.SequenceEqual(_teams)))
        {
            _teams.Clear();
            _teams.AddRange(InitialTeams);
        }
        if (string.IsNullOrWhiteSpace(_adminPlayTeamId) && _teams.Count > 0)
        {
            _adminPlayTeamId = _teams[0].TeamId;
        }
        if (IsAdmin && (string.IsNullOrEmpty(CurrentPlayerId) || CurrentPlayerId == "admin"))
        {
            var adminPlayer = _players.FirstOrDefault(p => p.IsAdmin);
            if (adminPlayer is not null)
            {
                CurrentPlayerId = adminPlayer.PlayerId;
                _ = OnCurrentPlayerIdChanged.InvokeAsync(adminPlayer.PlayerId);
            }
        }
    }

    protected override void OnInitialized()
    {
        if (Connection is not null)
        {
            Connection.PlayerJoined += OnPlayerJoined;
            Connection.PlayerLeft += OnPlayerLeft;
            Connection.TeamAdded += OnTeamAdded;
            Connection.TeamUpdated += OnTeamUpdated;
            Connection.TeamsReordered += OnTeamsReordered;
            Connection.TeamRemoved += OnTeamRemoved;
            Connection.PlayerTeamChanged += OnPlayerTeamChanged;
            Connection.SelfTeamSelectionToggled += OnSelfTeamSelectionToggled;
            Connection.PlayerAvatarChanged += OnPlayerAvatarChanged;
            Connection.PlayerReadyChanged += OnPlayerReadyChanged;
            Connection.JoinLockToggled += OnJoinLockToggled;
            Connection.RosterLockToggled += OnRosterLockToggled;
            Connection.ReadyReset += OnReadyReset;
            Connection.CountdownStarted += OnCountdownStarted;
            Connection.CountdownCanceled += OnCountdownCanceled;
            Connection.MatchStarted += OnMatchStarted;
        }
    }

    private void StartEditTeam(TeamSnapshot team)
    {
        _editingTeamId = team.TeamId;
        _editName = team.Name;
        _editColor = team.Color;
        _editCapacity = team.Capacity;
        _teamActionError = null;
    }

