    private DateTimeOffset _clockReceivedLocalTime = DateTimeOffset.UtcNow;
    private MatchClockSnapshot? _lastObservedClock;

    private string ClockText()
    {
        var clock = Room.Clock;
        if (clock is null) return "--:--";

        if (!ReferenceEquals(_lastObservedClock, clock) ||
            _lastObservedClock?.IsPaused != clock.IsPaused ||
            _lastObservedClock?.RemainingMilliseconds != clock.RemainingMilliseconds)
        {
            _lastObservedClock = clock;
            _clockReceivedLocalTime = DateTimeOffset.UtcNow;
        }

        var remaining = clock.RemainingMilliseconds;
        if (clock.FinishedAtUtc is null && !clock.IsPaused)
        {
            var elapsedSinceReceived = (long)(DateTimeOffset.UtcNow - _clockReceivedLocalTime).TotalMilliseconds;
            remaining = Math.Max(0, clock.RemainingMilliseconds - elapsedSinceReceived);
        }

        var totalSeconds = Math.Max(0, remaining / 1000);
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;

        if (totalSeconds == 0)
        {
            return "00:00 (Hết giờ)";
        }

        if (minutes == 0)
        {
            return $"{seconds:00}s ({seconds} giây)";
        }

        return $"{minutes:00}:{seconds:00} ({minutes} phút {seconds:00} giây)";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _typing?.Cancel();
        if (!string.IsNullOrEmpty(_reservationToken) && !string.IsNullOrEmpty(_activePuzzleId))
        {
            try { await Connection.ReleasePuzzleAsync(new ReleasePuzzleRequest(Room.RoomId, MyPlayerId, _activePuzzleId, _reservationToken, _session?.MatchId)); }
            catch { }
        }
        if (_session is not null) _session.PuzzleInteractionRequested -= OnPuzzleInteractionRequested;
        Connection.TeamStateUpdated -= OnTeamStateUpdated;
        Connection.PlayerMoved -= OnPlayerMoved;
        Connection.PuzzleReservationChanged -= OnPuzzleReservationChanged;
        Connection.PublicProgressUpdated -= OnPublicProgressUpdated;
        Connection.MatchPaused -= OnMatchPaused;
        Connection.MatchResumed -= OnMatchResumed;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch { }
        }
        _self?.Dispose();
        _clockTimer?.Dispose();
    }

