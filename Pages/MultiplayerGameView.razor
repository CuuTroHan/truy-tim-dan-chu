@using TruyTimDanChu.Game
@using TruyTimDanChu.Services
@using TruyTimDanChu.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

<main class="game-shell" style="--text-scale:1.25">
    <canvas @ref="_canvas" width="480" height="270" aria-label="Bản đồ thi trấn Minh Đăng"></canvas>
    <div class="world-vignette" aria-hidden="true"></div>

    <header class="hud-top">
        <div class="brand-mark">
            <b>✦</b>
            <span>TRUY TÌM<br><strong>DÂN CHỦ</strong></span>
        </div>

        <div class="hud-center">
            <div class="team-hud-badge" style="border-color: @(_session?.TeamColor ?? "#E53935");">
                <span class="team-hud-dot" style="background-color: @(_session?.TeamColor ?? "#E53935"); color: @(_session?.TeamColor ?? "#E53935");"></span>
                <span>@(_session?.TeamName?.ToUpperInvariant() ?? "ĐỘI THI ĐẤU")</span>
                <div class="team-members-hud">
                    <span class="teammate-hud-chip" title="Bạn">
                        👤 @_session?.Player.DisplayName (Bạn)
                    </span>
                    @if (_session is not null)
                    {
                        @foreach (var tm in _session.Teammates)
                        {
                            <span class="teammate-hud-chip" title="Đồng đội">
                                👥 @tm.DisplayName
                            </span>
                        }
                    }
                </div>
            </div>

            @if (Room.Clock is not null)
            {
                <div class="match-clock" role="timer" aria-label="Thời gian còn lại" title="Thời gian thi đấu còn lại">⏱ @ClockText()</div>
            }
            @if (_session is not null && (_session.Shards >= 4 || _session.FinaleDone))
            {
                <button class="team-hud-badge" style="background:#1b4733;border-color:#4caf50;color:#c8e6c9;cursor:pointer;padding:4px 12px;font-size:12px" @onclick="() => _victoryDismissed = false" title="Bấm để xem lại thông báo hoàn thành">
                    🏆 ĐÃ HOÀN THÀNH (4/4)
                </button>
            }
        </div>

        <nav class="hud-actions" aria-label="Điều khiển">
            @if (IsAdmin && Room.Status == RoomStatus.Playing)
            {
                <button title="Tạm dừng trận (Pause)" @onclick="PauseMatchAsync">⏸</button>
            }
            @if (IsAdmin && Room.Status == RoomStatus.Paused)
            {
                <button title="Tiếp tục trận (Continue)" @onclick="ResumeMatchAsync">▶</button>
            }
            @if (IsAdmin && Room.MatchId is not null && (Room.Status is RoomStatus.Playing or RoomStatus.Paused))
            {
                <button title="Kết thúc trận" @onclick="EndMatchAsync">⏹</button>
            }
            @if (IsAdmin)
            {
                <button title="Đóng phòng" @onclick="CloseRoomAsync">🔒</button>
            }
            <button title="Sổ Tiếng Nói" @onclick="ToggleJournal">▤</button>
            <button title="Gợi ý (H)" @onclick="ShowHint">?</button>
            <button title="Rời trận đấu" @onclick="LeaveGame">✕</button>
        </nav>
    </header>

    @if (Room.Status == RoomStatus.Paused)
    {
        <div class="pause-overlay" role="status">
            <div class="pause-card">
                <div class="pause-icon">⏸</div>
                <strong>TRẬN ĐẤU ĐANG TẠM DỪNG</strong>
                <span>Đồng hồ và toàn bộ thao tác gameplay đang đứng yên.</span>
                @if (IsAdmin)
                {
                    <button class="primary-button resume-button" @onclick="ResumeMatchAsync" disabled="@_pauseRequestPending">
                        ▶ TIẾP TỤC TRẬN ĐẤU (CONTINUE)
                    </button>
                }
                else
                {
                    <div class="pause-wait-notice">⏳ Vui lòng chờ Quản trị viên tiếp tục trận đấu...</div>
                }
            </div>
        </div>
    }

    @if (_tutorialOpen && _session is not null && (_session.Chapter == Chapter.Opening || _session.Shards == 0))
    {
        <div class="tutorial-backdrop">
            <section class="tutorial-card" aria-label="Hướng dẫn bắt đầu">
                <div class="tutorial-icon">⌖</div>
                <div class="modal-kicker">HƯỚNG DẪN BẮT ĐẦU · TRẬN ĐẤU NHÓM</div>
                <h2>Đi theo mũi tên vàng</h2>
                <div class="tutorial-steps">
                    <div><b>1</b><span><strong>Nhìn mũi tên vàng</strong><small>Mũi tên trên đầu nhân vật luôn chỉ thẳng tới mục tiêu hoặc người cần tương tác tiếp theo.</small></span></div>
                    <div><b>2</b><span><strong>Nhiệm vụ đầu tiên</strong><small>Đi theo mũi tên đến gặp <b>chú Trọng</b> ở Hòm Dân chủ (Quảng trường trung tâm) và nhấn <b>E</b>.</small></span></div>
                    <div><b>3</b><span><strong>Hợp tác đồng đội</strong><small>Cùng đồng đội giải các câu đố để thu thập đủ 4 mảnh ghép Tiếng Nói và về đích đầu tiên!</small></span></div>
                </div>
                <button class="primary-button wide" @onclick="CloseTutorial">ĐÃ HIỂU · BẮT ĐẦU NGAY →</button>
            </section>
        </div>
    }

    @if (!_victoryDismissed && _session is not null && (_session.Shards >= 4 || _session.FinaleDone) && _session.Panel != Panel.Dialogue)
    {
        <div class="modal-backdrop">
            <section class="game-modal ending-modal" aria-label="Hành trình hoàn thành">
                <div class="ending-emblem">🏆</div>
                <div class="modal-kicker">✦ ĐỘI BẠN ĐÃ HOÀN THÀNH XUẤT SẮC ✦</div>
                <h2>ĐÃ THU THẬP ĐỦ 4/4 MẢNH GHÉP!</h2>
                <p class="ending-quote">
                    “Dân chủ thực chất không nằm ở việc một quốc gia giống mô hình nào, mà nằm ở việc tiếng nói của người dân có được lắng nghe, phản hồi và chuyển hóa thành hành động hay không.”
                </p>
                <div class="ending-status-box" style="background: rgba(22,46,55,0.88); border: 2px solid #deb783; border-radius: 8px; padding: 14px 16px; margin: 16px 0; color: #f4e5c7; text-align: left;">
                    <div style="color: #ffd89b; font-weight: 800; font-size: 15px;">🎉 Chúc mừng! Đội @(_session.TeamName) đã giải xong toàn bộ 4/4 mảnh ghép.</div>
                    @if (Room.Status == RoomStatus.Playing)
                    {
                        <div style="margin-top: 8px; font-size: 13px; color: #d1dbcb; line-height: 1.5;">
                            ⏳ Đang chờ các đội còn lại hoàn thành hoặc Quản trị viên kết thúc trận đấu...
                        </div>
                    }
                </div>
                <div class="ending-actions" style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 18px;">
                    @if (IsAdmin && (Room.Status is RoomStatus.Playing or RoomStatus.Paused))
                    {
                        <button class="primary-button" @onclick="EndMatchAsync">
                            ⏹ KẾT THÚC TRẬN &amp; XEM BẢNG XẾP HẠNG
                        </button>
                    }
                    <button class="secondary-button" @onclick="() => _victoryDismissed = true">
                        XEM BẢN ĐỒ / THAM QUAN
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_session is not null)
    {
        <aside class="quest-card">
            <div class="eyebrow">✦ HÀNH TRÌNH <span>@_session.Shards / 4 MẢNH</span></div>
            <h2>@ChapterTitle()</h2>
            <p>@_session.Objective</p>
            <div class="next-target">
                <small>BƯỚC TIẾP THEO</small>
                <strong>➜ @(_session.Chapter == Chapter.Opening ? "Chú Trọng (Nhấn E khi lại gần)" : _session.Shards >= 4 ? "Hành trình đã khép vòng (4/4)" : _session.NextTarget)</strong>
            </div>
            <div class="shard-track" aria-label="@($"{_session.Shards} trên 4 mảnh đã tìm thấy")">
                @for (var i = 0; i < 4; i++) { <span class="@(i < _session.Shards ? "found" : "")">@(i < _session.Shards ? "✦" : "·")</span> }
            </div>
        </aside>

        @if (_publicProgress is { IsVisible: true } live && live.Teams.Count > 0)
        {
            <aside class="live-progress" aria-label="Tiến độ các đội">
                <div class="live-progress-head"><strong>TIẾN ĐỘ CÁC ĐỘI</strong><small>SERVER</small></div>
                @foreach (var team in live.Teams)
                {
                    <div class="live-progress-row">
                        <span class="team-swatch" style="background:@team.TeamColor"></span>
                        <span>@team.TeamName</span>
                        <span>@team.Shards/4</span>
                        <small>@PublicStatusText(team.Status)</small>
                    </div>
                }
            </aside>
        }

        <div class="area-chip multiplayer-area-chip">⌖ @_session.Area</div>
        <div class="bottom-help"><kbd>WASD</kbd> Di chuyển <i>·</i> <kbd>E</kbd> Tương tác <i>·</i> <kbd>H</kbd> Gợi ý</div>

        @if (_journalOpen)
        {
            <aside class="journal" aria-label="Sổ Tiếng Nói">
                <div class="journal-head"><strong>✦ SỔ TIẾNG NÓI</strong><button @onclick="ToggleJournal" aria-label="Đóng sổ">×</button></div>
                <p>Theo dõi đường đi của một tiếng nói.</p>
                <ol>
                    <li class="@(_session.Shards >= 1 ? "complete" : "")"><b>01</b><span><strong>Chủ thể quyền lực</strong><small>Người dân là điểm khởi đầu.</small></span></li>
                    <li class="@(_session.Shards >= 2 ? "complete" : "")"><b>02</b><span><strong>Cơ chế tham gia</strong><small>Ý kiến cần có đường đi.</small></span></li>
                    <li class="@(_session.Shards >= 3 ? "complete" : "")"><b>03</b><span><strong>Phản hồi và kết quả</strong><small>Được biết, được nói, được giải thích.</small></span></li>
                    <li class="@(_session.Shards >= 4 ? "complete" : "")"><b>04</b><span><strong>Giám sát và phản ánh</strong><small>Thông tin cần được xác minh.</small></span></li>
                </ol>
                <div class="journal-clues" style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed rgba(169, 141, 109, 0.4);">
                    <small style="font-weight: 700; letter-spacing: 0.05em; color: #875e4b; text-transform: uppercase;">✦ Chứng cứ phản ánh</small>
                    <ul style="list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-direction: column; gap: 4px; font-size: 11px;">
                        <li class="journal-clue-item" style="display: flex; align-items: center; gap: 6px; color: @(_session.Clues[0] ? "#365849" : "#7d7770"); font-weight: @(_session.Clues[0] ? "600" : "400");">
                            <span>@(_session.Clues[0] ? "✓" : "○")</span> <span>Biên lai đối chiếu</span>
                        </li>
                        <li class="journal-clue-item" style="display: flex; align-items: center; gap: 6px; color: @(_session.Clues[1] ? "#365849" : "#7d7770"); font-weight: @(_session.Clues[1] ? "600" : "400");">
                            <span>@(_session.Clues[1] ? "✓" : "○")</span> <span>Bảng quy trình tiếp nhận</span>
                        </li>
                        <li class="journal-clue-item" style="display: flex; align-items: center; gap: 6px; color: @(_session.Clues[2] ? "#365849" : "#7d7770"); font-weight: @(_session.Clues[2] ? "600" : "400");">
                            <span>@(_session.Clues[2] ? "✓" : "○")</span> <span>Lời kể người phản ánh</span>
                        </li>
                    </ul>
                </div>
                <footer>Đã đọc @_session.Lore.Count(x => x) / 4 bảng trong thư viện</footer>
            </aside>
        }

        @if (!string.IsNullOrEmpty(_session.Toast) && _session.Panel == Panel.None)
        {
            <div class="toast" role="status">@_session.Toast</div>
        }

        @if (_session.Panel == Panel.Dialogue && _session.CurrentLine is not null)
        {
            <div class="dialogue-wrap">
                <div class="dialogue-card">
                    <div class="portrait @PortraitClass(_session.CurrentLine.Speaker)" aria-hidden="true"><span></span></div>
                    <div class="dialogue-content">
                        <div class="dialogue-speaker">@_session.CurrentLine.Speaker <small>@(_session.DialogueIndex + 1) / @_session.Dialogue.Count</small></div>
                        <p>@_shownLine</p>
                        <button class="continue-button" @onclick="NextDialogueAsync">@(_lineComplete ? "TIẾP TỤC" : "HIỆN HẾT") ↵</button>
                    </div>
                </div>
            </div>
        }


        @if (_reservation is { IsReserved: true } reservation && reservation.OwnerPlayerId != MyPlayerId)
        {
            <div class="puzzle-owner-banner" role="status">
                🔒 <strong>@reservation.OwnerDisplayName</strong> đang giải @GetPuzzleDisplayName(reservation.PuzzleId).
            </div>
        }

        @if (_session.Panel == Panel.Mirrors && !string.IsNullOrEmpty(_reservationToken))
        {
            <div class="modal-backdrop">
                <section class="game-modal" aria-label="Quyền giải Gương trung tâm">
                    <button class="modal-close" @onclick="ClosePuzzleAsync" aria-label="Đóng và trả quyền">×</button>
                    <div class="modal-kicker">MẢNH 01 · CHỦ THỂ QUYỀN LỰC</div>
                    <h2>Hướng ánh sáng về tâm</h2>
                    <p class="modal-lead">Xoay bốn gương để ánh sáng của mọi người cùng gặp nhau. Chỉ máy chủ mới xác nhận kết quả.</p>
                    <div class="mirror-grid">
                        @for (var i = 0; i < 4; i++)
                        {
                            var index = i;
                            var location = i switch { 0 => "TÂY", 1 => "BẮC", 2 => "ĐÔNG", _ => "NAM" };
                            <button @onclick="() => TurnMirror(index)" disabled="@_isSubmitting">
                                <small>GƯƠNG PHÍA @location</small>
                                <b>@Direction(_session.Mirrors[i])</b>
                                <small>Hướng về tâm</small>
                            </button>
                        }
                    </div>
                    <div class="reservation-proof">
                        <b>🔐 Khóa theo trận + đội + câu đố</b>
                        <span>Sai @_session.Progress.WrongAnswerCount lần · hết hạn @_reservation?.ExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_puzzleMessage))
                    {
                        <p class="modal-feedback" role="status">@_puzzleMessage</p>
                    }
                    <div class="modal-footer">
                        <span>Mỗi đáp án sai hợp lệ được tính một lần cho đội.</span>
                        <button class="primary-button small" @onclick="SubmitMirrorsAsync" disabled="@_isSubmitting">
                            @(_isSubmitting ? "ĐANG KIỂM TRA…" : "THỬ ÁNH SÁNG →")
                        </button>
                    </div>
                </section>
            </div>
        }

        @if (_session.Panel == Panel.Draft && !string.IsNullOrEmpty(_reservationToken))
        {
            <div class="modal-backdrop">
                <section class="game-modal" aria-label="Quyền giải Cỗ máy góp ý">
                    <button class="modal-close" @onclick="ClosePuzzleAsync" aria-label="Đóng và trả quyền">×</button>
                    <div class="modal-kicker">MẢNH 02 · CƠ CHẾ THAM GIA</div>
                    <h2>Đường đi của một ý kiến</h2>
                    <p class="modal-lead">Sắp xếp các bước từ lúc dự thảo được công khai tới khi có quyết định.</p>
                    <div class="draft-list">
                        @for (var i = 0; i < _session.DraftLabels.Count; i++)
                        {
                            var index = i;
                            <div>
                                <b>@(i + 1)</b>
                                <span>@_session.DraftLabels[i]</span>
                                <button @onclick="() => MoveDraft(index, -1)" disabled="@(i == 0 || _isSubmitting)" aria-label="@($"Đưa {_session.DraftLabels[i]} lên")">↑</button>
                                <button @onclick="() => MoveDraft(index, 1)" disabled="@(i == _session.DraftLabels.Count - 1 || _isSubmitting)" aria-label="@($"Đưa {_session.DraftLabels[i]} xuống")">↓</button>
                            </div>
                        }
                    </div>
                    <div class="reservation-proof">
                        <b>🔐 Khóa theo trận + đội + câu đố</b>
                        <span>Sai @_session.Progress.WrongAnswerCount lần · hết hạn @_reservation?.ExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_puzzleMessage))
                    {
                        <p class="modal-feedback" role="status">@_puzzleMessage</p>
                    }
                    <div class="modal-footer">
                        <span>Mỗi đáp án sai hợp lệ được tính một lần cho đội.</span>
                        <button class="primary-button small" @onclick="SubmitDraftAsync" disabled="@_isSubmitting">
                            @(_isSubmitting ? "ĐANG KIỂM TRA…" : "VẬN HÀNH CỖ MÁY →")
                        </button>
                    </div>
                </section>
            </div>
        }

        @if (_session.Panel == Panel.River && !string.IsNullOrEmpty(_reservationToken))
        {
            <div class="modal-backdrop">
                <section class="game-modal" aria-label="Quyền giải Bản phương án cây cầu">
                    <button class="modal-close" @onclick="ClosePuzzleAsync" aria-label="Đóng và trả quyền">×</button>
                    <div class="modal-kicker">MẢNH 03 · PHẢN HỒI VÀ KẾT QUẢ</div>
                    <h2>Để dòng ý kiến đi đủ đường</h2>
                    <p class="modal-lead">Dòng sáng đi từ trạm 1 sang trạm 2 ở bên phải, xuống trạm 3, sang trái tới trạm 4 rồi quay lên. Hãy xoay biển theo đường đi đó.</p>
                    <div class="river-route">
                        @for (var i = 0; i < 4; i++)
                        {
                            var index = i;
                            var title = i switch { 0 => "CÔNG KHAI", 1 => "HỌP DÂN", 2 => "GHI NHẬN", _ => "ĐỐI THOẠI" };
                            <button @onclick="() => TurnRiver(index)" disabled="@_isSubmitting">
                                <small>0@(i + 1)</small>
                                <strong>@title</strong>
                                <b>@Direction(_session.RiverSigns[i])</b>
                            </button>
                        }
                    </div>
                    <div class="reservation-proof">
                        <b>🔐 Khóa theo trận + đội + câu đố</b>
                        <span>Sai @_session.Progress.WrongAnswerCount lần · hết hạn @_reservation?.ExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_puzzleMessage))
                    {
                        <p class="modal-feedback" role="status">@_puzzleMessage</p>
                    }
                    <div class="modal-footer">
                        <span>Mỗi đáp án sai hợp lệ được tính một lần cho đội.</span>
                        <button class="primary-button small" @onclick="SubmitRiverAsync" disabled="@_isSubmitting">
                            @(_isSubmitting ? "ĐANG KIỂM TRA…" : "CHO DÒNG Ý KIẾN CHẠY →")
                        </button>
                    </div>
                </section>
            </div>
        }

        @if (_session.Panel == Panel.News && _activePuzzleId == PuzzleIds.News)
        {
            <div class="modal-backdrop">
                <section class="game-modal" aria-label="Quyền giải Bảng tin">
                    <button class="modal-close" @onclick="ClosePuzzleAsync" aria-label="Đóng và trả quyền">×</button>
                    <div class="modal-kicker">MẢNH 04 · GIÁM SÁT VÀ PHẢN ÁNH</div>
                    <h2>Một tin đang lan trên phố</h2>
                    <p class="modal-lead">Có phản ánh về việc thu tiền phạt qua tài khoản cá nhân. Quang cần quyết định bước tiếp theo.</p>
                    <div class="evidence-list">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="@(_session.Clues[i] ? "found" : "")">
                                <b>@(_session.Clues[i] ? "✓" : "?")</b>@_session.ClueLabels[i]
                            </div>
                        }
                    </div>
                    @if (_session.NewsNoise > 0)
                    {
                        <p class="noise-warning">⚠ Nhiễu thông tin: @_session.NewsNoise / 3 · Có thể xem lại quyết định</p>
                    }
                    <div class="reservation-proof">
                        <b>🔐 Khóa theo trận + đội + câu đố</b>
                        <span>Sai @_session.Progress.WrongAnswerCount lần · hết hạn @_reservation?.ExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                    <div class="choice-list">
                        <button @onclick="() => ChooseNewsAsync(0)" disabled="@_isSubmitting"><b>01</b> Chia sẻ ngay để gây áp lực <span>↗</span></button>
                        <button @onclick="() => ChooseNewsAsync(1)" disabled="@_isSubmitting"><b>02</b> Bỏ qua hoàn toàn <span>↗</span></button>
                        <button @onclick="() => ChooseNewsAsync(2)" disabled="@_isSubmitting"><b>03</b> Gom chứng cứ, gửi phản ánh để xác minh <span>↗</span></button>
                    </div>
                    @if (!string.IsNullOrEmpty(_puzzleMessage))
                    {
                        <p class="modal-feedback" role="status">@_puzzleMessage</p>
                    }
                </section>
            </div>
        }

        @if (_session.Panel == Panel.Finale && _activePuzzleId == PuzzleIds.Finale)
        {
            <div class="modal-backdrop">
                <section class="game-modal" aria-label="Quyền giải Thử thách cuối">
                    <button class="modal-close" @onclick="ClosePuzzleAsync" aria-label="Đóng và trả quyền">×</button>
                    <div class="modal-kicker">HÒM DÂN CHỦ · BỐN MẢNH</div>
                    @if (_session.FinaleOrderCompleted)
                    {
                        <h2>Câu trả lời phải quay về</h2>
                        <p class="modal-lead">Bốn mảnh đều sáng nhưng hòm vẫn chưa mở. Hãy đưa lá thư qua bốn chặng cuối.</p>
                        <div class="return-route">
                            @for (var i = 0; i < 4; i++)
                            {
                                var step = i;
                                var title = i switch { 0 => "TIẾP NHẬN", 1 => "GIẢI TRÌNH", 2 => "ĐIỀU CHỈNH", _ => "TRẢ KẾT QUẢ" };
                                <button class="@(_session.ReturnStep > i ? "done" : "")" disabled="@(i != _session.ReturnStep || _isSubmitting)" @onclick="() => AdvanceReturnStepAsync(step)">@(i + 1). @title</button>
                                @if (i < 3) { <i>→</i> }
                            }
                        </div>
                    }
                    else
                    {
                        <h2>Khép vòng Tiếng Nói</h2>
                        <p class="modal-lead">Chọn bốn mảnh theo hành trình từ người dân tới kết quả được phản hồi.</p>
                        <div class="final-slots">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="@(_session.FinaleSequence.Count > i ? "filled" : "")">
                                    @(_session.FinaleSequence.Count > i ? _session.FinalLabels[_session.FinaleSequence[i]] : "0" + (i + 1) + " · CHƯA ĐẶT")
                                </div>
                            }
                        </div>
                        <div class="final-pieces">
                            @for (var i = 0; i < 4; i++)
                            {
                                var index = i;
                                <button disabled="@(_session.FinaleSequence.Contains(index) || _isSubmitting)" @onclick="() => AddFinalePiece(index)">@_session.FinalLabels[i]</button>
                            }
                        </div>
                    }
                    <div class="reservation-proof">
                        <b>🔐 Khóa theo trận + đội + câu đố</b>
                        <span>Sai @_session.Progress.WrongAnswerCount lần · hết hạn @_reservation?.ExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_puzzleMessage))
                    {
                        <p class="modal-feedback" role="status">@_puzzleMessage</p>
                    }
                    <div class="modal-footer">
                        @if (!_session.FinaleOrderCompleted)
                        {
                            <button class="secondary-button small" @onclick="ResetFinaleOrder" disabled="@_isSubmitting">LÀM LẠI</button>
                            <button class="primary-button small" @onclick="SubmitFinaleOrderAsync" disabled="@(_session.FinaleSequence.Count != 4 || _isSubmitting)">
                                @(_isSubmitting ? "ĐANG KIỂM TRA…" : "XÁC NHẬN THỨ TỰ →")
                            </button>
                        }
                    </div>
                </section>
            </div>
        }
    }
</main>

@code {
    [Parameter] public MultiplayerConnection Connection { get; set; } = null!;
    [Parameter] public RoomSnapshot Room { get; set; } = null!;
    [Parameter] public IReadOnlyList<PlayerSnapshot> Players { get; set; } = [];
    [Parameter] public IReadOnlyList<TeamSnapshot> Teams { get; set; } = [];
    [Parameter] public string MyPlayerId { get; set; } = null!;
    [Parameter] public string? AdminToken { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnLeaveMatch { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MultiplayerGameView>? _self;
    private MultiplayerSession? _session;
    private bool _journalOpen;
    private bool _disposed;
    private string? _activePuzzleId;
    private PuzzleReservationState? _reservation;
    private string? _reservationToken;
    private string? _puzzleMessage;
    private bool _isSubmitting;
    private Timer? _clockTimer;
    private PublicProgressSnapshot? _publicProgress;
    private bool _pauseRequestPending;
    private bool _tutorialOpen = true;
    private bool _victoryDismissed = false;
    // Typewriter effect cho dialogue (giống solo)
    private string _shownLine = "";
    private string? _lineKey;
    private bool _lineComplete = true;
    private CancellationTokenSource? _typing;

    private void CloseTutorial()
    {
        _tutorialOpen = false;
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        var myPlayer = Players.FirstOrDefault(p => p.PlayerId == MyPlayerId);
        var displayName = myPlayer?.DisplayName ?? (IsAdmin ? "Admin" : "Người chơi");
        var avatarId = myPlayer?.AvatarId ?? AvatarCatalog.DefaultAvatarId;

        _session = new MultiplayerSession(MyPlayerId, displayName, avatarId)
        {
            RoomId = Room.RoomId,
            OnSendMovement = input => Connection.SendMovementAsync(input),
            OnInteract = req => Connection.InteractAsync(req)
        };
        _session.PuzzleInteractionRequested += OnPuzzleInteractionRequested;
        Connection.TeamStateUpdated += OnTeamStateUpdated;
        Connection.PlayerMoved += OnPlayerMoved;
        Connection.PuzzleReservationChanged += OnPuzzleReservationChanged;
        Connection.PublicProgressUpdated += OnPublicProgressUpdated;
        Connection.MatchPaused += OnMatchPaused;
        Connection.MatchResumed += OnMatchResumed;
        _clockTimer = new Timer(_ =>
        {
            if (!_disposed) InvokeAsync(StateHasChanged);
        }, null, 250, 250);

        // Fetch current team state
        var response = await Connection.GetMyTeamStateAsync(new GetTeamStateRequest(Room.RoomId, MyPlayerId));
        if (response.Success && response.State is not null)
        {
            _session.ApplySnapshot(response.State);
        }
    }

    private void OnPlayerMoved(PlayerMovedBroadcast ev)
    {
        if (_disposed || _session is null) return;
        _session.UpdateTeammatePosition(ev.PlayerId, ev.X, ev.Y, ev.Facing, ev.Walking, ev.Sequence, ev.ServerTimestampMs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
            await _module.InvokeVoidAsync("start", _self, _canvas);
        }
    }

    private void OnTeamStateUpdated(TeamGameStateSnapshot snapshot)
    {
        if (_disposed || _session is null) return;
        InvokeAsync(() =>
        {
            _session.ApplySnapshot(snapshot);
            StateHasChanged();
        });
    }

    private void OnPublicProgressUpdated(PublicProgressSnapshot snapshot)
    {
        if (_disposed) return;
        InvokeAsync(() => { _publicProgress = snapshot; StateHasChanged(); });
    }

    private async Task PauseMatchAsync()
    {
        if (!IsAdmin || _pauseRequestPending || Room.MatchId is null || AdminToken is null) return;
        _pauseRequestPending = true;
        try 
        { 
            var res = await Connection.AdminPauseMatchAsync(new AdminPauseMatchRequest(Room.RoomId, AdminToken, Room.MatchId, Guid.NewGuid().ToString("N"))); 
            if (res.Success)
            {
                Room = Room with { Status = RoomStatus.Paused };
                _lastObservedClock = null;
                StateHasChanged();
            }
        }
        finally { _pauseRequestPending = false; }
    }

    private async Task ResumeMatchAsync()
    {
        if (!IsAdmin || _pauseRequestPending || Room.MatchId is null || AdminToken is null) return;
        _pauseRequestPending = true;
        try 
        { 
            var res = await Connection.AdminResumeMatchAsync(new AdminResumeMatchRequest(Room.RoomId, AdminToken, Room.MatchId, Guid.NewGuid().ToString("N"))); 
            if (res.Success)
            {
                Room = Room with { Status = RoomStatus.Playing };
                _lastObservedClock = null;
                _clockReceivedLocalTime = DateTimeOffset.UtcNow;
                StateHasChanged();
            }
        }
        finally { _pauseRequestPending = false; }
    }

    private void OnMatchPaused(MatchPausedEvent ev)
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            Room = Room with { Status = RoomStatus.Paused };
            _lastObservedClock = null;
            StateHasChanged();
        });
    }

    private void OnMatchResumed(MatchResumedEvent ev)
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            Room = Room with { Status = RoomStatus.Playing };
            _lastObservedClock = null;
            _clockReceivedLocalTime = DateTimeOffset.UtcNow;
            StateHasChanged();
        });
    }

    private async Task EndMatchAsync()
    {
        if (!IsAdmin || Room.MatchId is null || string.IsNullOrWhiteSpace(AdminToken)) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Kết thúc trận hiện tại?")) return;
        await Connection.AdminEndMatchAsync(new AdminEndMatchRequest(Room.RoomId, AdminToken, Room.MatchId, Guid.NewGuid().ToString("N")));
    }

    private async Task CloseRoomAsync()
    {
        if (!IsAdmin || string.IsNullOrWhiteSpace(AdminToken)) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Đóng phòng? Người chơi sẽ không thể quay lại.")) return;
        await Connection.AdminCloseRoomAsync(new AdminCloseRoomRequest(Room.RoomId, AdminToken, Guid.NewGuid().ToString("N")));
    }

    private void OnPuzzleReservationChanged(PuzzleReservationState state)
    {
        if (_disposed || _session is null || state.TeamId != _session.TeamId) return;
        InvokeAsync(() =>
        {
            if (state.IsReserved)
            {
                _reservation = state;
            }
            else
            {
                if (_reservation?.PuzzleId == state.PuzzleId)
                {
                    _reservation = null;
                }
                if (_activePuzzleId == state.PuzzleId)
                {
                    _reservationToken = null;
                    _activePuzzleId = null;
                    if (_session.Panel == Panel.Mirrors)
                    {
                        _session.ClosePanel();
                        _session.ResetMirrors();
                    }
                    else if (_session.Panel == Panel.Draft)
                    {
                        _session.ClosePanel();
                        _session.ResetDraft();
                    }
                    else if (_session.Panel == Panel.River)
                    {
                        _session.ClosePanel();
                        _session.ResetRiver();
                    }
                    else if (_session.Panel == Panel.News)
                    {
                        _session.ClosePanel();
                    }
                    else if (_session.Panel == Panel.Finale)
                    {
                        _session.ClosePanel();
                        _session.ResetFinaleSequence();
                    }
                    _puzzleMessage = "Quyền giải đã được trả về cho đội.";
                }
            }
            StateHasChanged();
        });
    }

    private void OnPuzzleInteractionRequested(string puzzleId) => _ = InvokeAsync(async () =>
    {
        if (_session is null) return;
        var response = await Connection.ReservePuzzleAsync(new ReservePuzzleRequest(Room.RoomId, MyPlayerId, puzzleId, _session.MatchId));
        _reservation = response.Reservation;
        if (response.Success && !string.IsNullOrEmpty(response.ReservationToken))
        {
            _reservationToken = response.ReservationToken;
            _activePuzzleId = puzzleId;
            if (puzzleId == PuzzleIds.Mirrors)
            {
                _session.ResetMirrors();
                _puzzleMessage = "Xoay gương rồi gửi để máy chủ kiểm tra.";
                _session.OpenPanel(Panel.Mirrors);
            }
            else if (puzzleId == PuzzleIds.Draft)
            {
                _session.ResetDraft();
                _puzzleMessage = "Sắp xếp quy trình rồi gửi để máy chủ kiểm tra.";
                _session.OpenPanel(Panel.Draft);
            }
            else if (puzzleId == PuzzleIds.River)
            {
                _session.ResetRiver();
                _puzzleMessage = "Xoay biển chỉ hướng rồi gửi để máy chủ kiểm tra.";
                _session.OpenPanel(Panel.River);
            }
            else if (puzzleId == PuzzleIds.News)
            {
                _puzzleMessage = "Đọc kỹ thông tin và lựa chọn cách phản ánh.";
                _session.OpenPanel(Panel.News);
            }
            else if (puzzleId == PuzzleIds.Finale)
            {
                _session.ResetFinaleSequence();
                _puzzleMessage = _session.FinaleOrderCompleted
                    ? "Đưa lá thư qua bốn chặng cuối."
                    : "Sắp xếp bốn mảnh theo hành trình của tiếng nói.";
                _session.OpenPanel(Panel.Finale);
            }
        }
        else
        {
            var puzzleName = GetPuzzleDisplayName(puzzleId);
            _puzzleMessage = response.ErrorCode == PuzzleReservationErrorCodes.PuzzleOccupied
                ? $"{response.Reservation?.OwnerDisplayName ?? "Một đồng đội"} đang giải {puzzleName}."
                : $"Không thể giữ quyền: {response.ErrorCode}";
        }
        StateHasChanged();
    });

    private void TurnMirror(int index)
    {
        if (!_isSubmitting) { _session?.TurnMirror(index); Sfx("click"); StateHasChanged(); }
    }

    private void MoveDraft(int index, int direction)
    {
        if (!_isSubmitting) _session?.MoveDraft(index, direction);
    }

    private void TurnRiver(int index)
    {
        if (!_isSubmitting) { _session?.TurnRiver(index); Sfx("click"); StateHasChanged(); }
    }

    private async Task SubmitMirrorsAsync()
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.Mirrors,
                _reservationToken,
                _session.Mirrors.ToArray(),
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);
            if (!response.Success)
            {
                _puzzleMessage = $"Máy chủ từ chối đáp án: {response.ErrorCode}";
                Sfx("wrong");
            }
            else if (!response.Correct)
            {
                _puzzleMessage = $"Một vài tia sáng chưa chạm vào tâm. Đội đã sai {response.WrongAnswerCount} lần.";
                Sfx("wrong");
            }
            else
            {
                Sfx("success");
                _reservationToken = null;
                _activePuzzleId = null;
                _reservation = null;
                _session.ClosePanel();
                _session.ResetMirrors();
                _session.ShowDialogue([
                    new("Quang", "Không có một ngọn đèn nào tự thắp sáng cả quảng trường."),
                    new("Kiều Anh", "Quyền lực thuộc về Nhân dân. Hãy mang mảnh đầu tiên tới Xưởng Dự thảo.")
                ]);
                RefreshDialogue();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitDraftAsync()
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.Draft,
                _reservationToken,
                _session.DraftSequence.ToArray(),
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);
            if (!response.Success)
            {
                _puzzleMessage = $"Máy chủ từ chối đáp án: {response.ErrorCode}";
                Sfx("wrong");
            }
            else if (!response.Correct)
            {
                var draftHint = (_session.Progress.DraftFailures >= 2)
                    ? "Bước đầu là công khai dự thảo; bước cuối là quyết định."
                    : "Có bước đang đi trước khi nó được chuẩn bị.";
                _puzzleMessage = $"{draftHint} (Tổng số lần sai của đội: {response.WrongAnswerCount})";
                Sfx("wrong");
            }
            else
            {
                Sfx("success");
                _reservationToken = null;
                _activePuzzleId = null;
                _reservation = null;
                _session.ClosePanel();
                _session.ResetDraft();
                _session.ShowDialogue([
                    new("Phương", "Gửi được ý kiến mới chỉ là bước đầu. Giờ mình thấy ý kiến được tiếp nhận, giải trình và chỉnh lý như thế nào."),
                    new("Nam", "Mình sẽ mang phần phản hồi trở lại với người đã góp ý.")
                ]);
                RefreshDialogue();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitRiverAsync()
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.River,
                _reservationToken,
                _session.RiverSigns.ToArray(),
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);
            if (!response.Success)
            {
                _puzzleMessage = $"Máy chủ từ chối đáp án: {response.ErrorCode}";
                Sfx("wrong");
            }
            else if (!response.Correct)
            {
                int[] expected = [1, 2, 3, 0];
                int firstWrong = 0;
                for (int i = 0; i < 4; i++)
                {
                    if (_session.RiverSigns[i] != expected[i])
                    {
                        firstWrong = i;
                        break;
                    }
                }
                _puzzleMessage = $"Dòng ý kiến dừng ở trạm {firstWrong + 1}. Hãy chỉnh lại biển. (Tổng số lần sai của đội: {response.WrongAnswerCount})";
                Sfx("wrong");
            }
            else
            {
                Sfx("success");
                _reservationToken = null;
                _activePuzzleId = null;
                _reservation = null;
                _session.ClosePanel();
                _session.ResetRiver();
                _session.ShowDialogue([
                    new("Dũng", "Ý kiến được lắng nghe không chỉ dừng lại ở biên bản, mà đi vào từng thanh dầm của cây cầu."),
                    new("Nam", "Sau khi cầu thông, mình nghe có tiếng xì xào ở phía Bảng tin.")
                ]);
                RefreshDialogue();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ChooseNewsAsync(int option)
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.News,
                _reservationToken,
                [option],
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);
            if (!response.Success)
            {
                if (response.ErrorCode == PuzzleReservationErrorCodes.PrerequisiteNotMet)
                {
                    _puzzleMessage = "Cần đủ ba manh mối để gửi phản ánh.";
                }
                else
                {
                    _puzzleMessage = $"Máy chủ từ chối đáp án: {response.ErrorCode}";
                }
                Sfx("wrong");
            }
            else if (!response.Correct)
            {
                if (option == 0)
                {
                    _puzzleMessage = "Tin lan nhanh, nhưng chưa được xác minh. Có thể xem lại quyết định.";
                }
                else
                {
                    _puzzleMessage = "Im lặng khiến vấn đề không được xem xét. Có thể xem lại quyết định.";
                }
                Sfx("wrong");
            }
            else
            {
                Sfx("success");
                _reservationToken = null;
                _activePuzzleId = null;
                _reservation = null;
                _session.ClosePanel();
                _session.ShowDialogue([
                    new("Hán", "Tiếp nhận không phải là dấu chấm hết. Mọi phản ánh đều phải có địa chỉ xử lý."),
                    new("Quang", "Mảnh ghép thứ tư: Giám sát và phản hồi."),
                    new("Kiều Anh", "Đã đủ bốn mảnh. Giờ hãy mang chúng về Hòm Dân chủ ở trung tâm.")
                ]);
                RefreshDialogue();
            }
        }
        catch (Exception ex)
        {
            _puzzleMessage = $"Lỗi gửi lựa chọn: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void AddFinalePiece(int index)
    {
        if (_session is null || _isSubmitting || _session.FinaleSequence.Contains(index)) return;
        _session.FinaleSequence.Add(index);
        StateHasChanged();
    }

    private void ResetFinaleOrder()
    {
        if (_session is null || _isSubmitting) return;
        _session.ResetFinaleSequence();
        _puzzleMessage = null;
        StateHasChanged();
    }

    private async Task SubmitFinaleOrderAsync()
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        if (_session.FinaleSequence.Count != 4) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var answer = _session.FinaleSequence.ToArray();
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.Finale,
                _reservationToken,
                answer,
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);

            if (!response.Success)
            {
                _puzzleMessage = $"Máy chủ từ chối: {response.ErrorCode}";
                Sfx("wrong");
            }
            else if (!response.Correct)
            {
                _session.ResetFinaleSequence();
                _puzzleMessage = "Hãy xếp theo hành trình của một tiếng nói, từ người dân tới phản hồi.";
                Sfx("wrong");
            }
            else
            {
                Sfx("success");
                // Stage 1 đúng: server giữ reservation, đóng modal để hiện đối thoại, sau đó mở lại Stage 2
                _session.ClosePanel();
                _session.ShowDialogue([
                    new("Trọng", "Bốn mảnh đều sáng, nhưng Hòm Dân chủ vẫn chưa mở..."),
                    new("Nam", "Vì câu trả lời chưa quay lại với người dân. Mình đang mang lá thư này."),
                    new("Quang", "Vậy hãy khép nốt vòng Tiếng Nói.")
                ], () =>
                {
                    if (!string.IsNullOrEmpty(_reservationToken))
                    {
                        _session.OpenPanel(Panel.Finale);
                    }
                });
                RefreshDialogue();
            }
        }
        catch (Exception ex)
        {
            _puzzleMessage = $"Lỗi gửi đáp án: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task AdvanceReturnStepAsync(int step)
    {
        if (_session is null || string.IsNullOrEmpty(_reservationToken) || _isSubmitting) return;
        _isSubmitting = true;
        _puzzleMessage = null;
        try
        {
            var response = await Connection.SubmitPuzzleAsync(new SubmitPuzzleRequest(
                Room.RoomId,
                MyPlayerId,
                PuzzleIds.Finale,
                _reservationToken,
                [step],
                Guid.NewGuid().ToString("N"), _session.MatchId));

            if (response.State is not null) _session.ApplySnapshot(response.State);

            if (!response.Success)
            {
                _puzzleMessage = response.ErrorCode == PuzzleReservationErrorCodes.InvalidReturnStep
                    ? "Hãy đi theo thứ tự của lá thư."
                    : $"Máy chủ từ chối: {response.ErrorCode}";
                Sfx("wrong");
            }
            else
            {
                if (step == 0) { _puzzleMessage = "Hán đã tiếp nhận lá thư."; Sfx("click"); }
                else if (step == 1) { _puzzleMessage = "Phương nhận được lời giải trình."; Sfx("click"); }
                else if (step == 2) { _puzzleMessage = "Dũng thấy phương án đã được điều chỉnh."; Sfx("click"); }
                else if (step == 3)
                {
                    Sfx("success");
                    _reservationToken = null;
                    _activePuzzleId = null;
                    _reservation = null;
                    _session.ClosePanel();
                    _session.ShowDialogue([
                        new("Nam", "Tiếp nhận. Giải trình. Điều chỉnh hoặc xử lý. Và cuối cùng: trả kết quả."),
                        new("Trọng", "Thứ chúng ta tìm không nằm trong chiếc hòm. Nó nằm trong cách tiếng nói đi tới người có trách nhiệm và câu trả lời quay về với người dân."),
                        new("Kiều Anh", "Quyền làm chủ cần được bảo đảm bằng pháp luật, dân chủ trực tiếp và đại diện, khả năng giám sát cùng trách nhiệm giải trình."),
                        new("Quang", "Dân chủ thực chất không nằm ở việc một quốc gia giống mô hình nào, mà nằm ở việc tiếng nói của người dân có được lắng nghe, phản hồi và chuyển hóa thành hành động hay không.")
                    ]);
                    RefreshDialogue();
                }
            }
        }
        catch (Exception ex)
        {
            _puzzleMessage = $"Lỗi gửi chặng: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ClosePuzzleAsync()
    {
        var token = _reservationToken;
        var puzzleId = _activePuzzleId;
        _reservationToken = null;
        _activePuzzleId = null;
        if (_session is not null)
        {
            if (_session.Panel == Panel.Mirrors)
            {
                _session.ClosePanel();
                _session.ResetMirrors();
            }
            else if (_session.Panel == Panel.Draft)
            {
                _session.ClosePanel();
                _session.ResetDraft();
            }
            else if (_session.Panel == Panel.River)
            {
                _session.ClosePanel();
                _session.ResetRiver();
            }
            else if (_session.Panel == Panel.News)
            {
                _session.ClosePanel();
            }
            else if (_session.Panel == Panel.Finale)
            {
                _session.ClosePanel();
                _session.ResetFinaleSequence();
            }
            else
            {
                _session.ClosePanel();
            }
        }
        if (!string.IsNullOrEmpty(token) && !string.IsNullOrEmpty(puzzleId))
            await Connection.ReleasePuzzleAsync(new ReleasePuzzleRequest(Room.RoomId, MyPlayerId, puzzleId, token, _session?.MatchId));
    }

    [JSInvokable]
    public Frame? Tick(double timestamp, int keys)
    {
        if (_disposed || _session is null) return null;
        var frame = _session.Tick(timestamp, (Room.Status == RoomStatus.Paused || _tutorialOpen) ? 0 : keys);
        if (frame.UiDirty) _ = InvokeAsync(StateHasChanged);
        return frame;
    }

    [JSInvokable]
    public void PauseClock()
    {
        _session?.PauseClock();
    }

    [JSInvokable]
    public void KeyAction(string code)
    {
        if (_disposed || _session is null) return;
        _ = InvokeAsync(async () =>
        {
            if (_tutorialOpen)
            {
                if (code is "KeyE" or "Space" or "Enter" or "Escape") { CloseTutorial(); return; }
                return;
            }
            if (_session.Panel == Panel.Dialogue)
            {
                if (code is "KeyE" or "Space" or "Enter") await NextDialogueAsync();
                return;
            }
            if (code == "Escape")
            {
                if (_session.Panel is Panel.Mirrors or Panel.Draft or Panel.River or Panel.News or Panel.Finale) _ = ClosePuzzleAsync();
                else if (_session.Panel != Panel.None) _session.ClosePanel();
            }
            else if (_session.Panel == Panel.None)
            {
                if (code is "KeyE" or "Space" or "Enter") _session.Interact();
                else if (code == "KeyH") ShowHint();
            }
            StateHasChanged();
        });
    }

    private async Task NextDialogueAsync()
    {
        if (_session is null) return;
        if (!_lineComplete) { _typing?.Cancel(); _shownLine = _session.CurrentLine?.Text ?? ""; _lineComplete = true; StateHasChanged(); }
        else { _session.AdvanceDialogue(); RefreshDialogue(); }
        await Task.CompletedTask;
    }

    private void RefreshDialogue()
    {
        if (_session is null) return;
        var line = _session.CurrentLine;
        var key = _session.Panel == Panel.Dialogue && line is not null ? $"{_session.DialogueIndex}:{line.Speaker}:{line.Text}" : null;
        if (key != _lineKey)
        {
            _typing?.Cancel(); _lineKey = key;
            if (line is not null && _session.Panel == Panel.Dialogue)
            {
                _shownLine = ""; _lineComplete = false; _ = TypeLine(line.Text);
            }
            else { _shownLine = ""; _lineComplete = true; }
        }
        StateHasChanged();
    }

    private async Task TypeLine(string value)
    {
        _typing = new CancellationTokenSource(); var token = _typing.Token;
        try
        {
            for (var i = 1; i <= value.Length; i++)
            {
                await Task.Delay(28, token); _shownLine = value[..i];
                if (i % 2 == 0 || i == value.Length) await InvokeAsync(StateHasChanged);
            }
            _lineComplete = true; await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void Sfx(string kind)
    {
        var muted = _session?.Muted ?? false;
        if (_module is not null) _ = _module.InvokeVoidAsync("playSound", kind, muted);
    }

